# Public build-time configuration embedded in the browser bundle.
# Do not put secrets, private keys or credentials in REACT_APP_* variables.
REACT_APP_API_URL=http://localhost:5000/api
# Optional override; the committed MovieTap Web client ID is used when omitted.
# REACT_APP_GOOGLE_CLIENT_ID=another-google-web-client-id.apps.googleusercontent.com
# Cloudflare demo example:
# REACT_APP_API_URL=https://your-backend-cloudflare-url.trycloudflare.com/api
